# Line endings: LF everywhere so generated copies stay byte-identical on Windows, macOS and Linux
# (package-parity gate: scripts/build_agent_adapters.py --check).
* text=auto eol=lf

*.md        text eol=lf
*.json      text eol=lf
*.jsonl     text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.csv       text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=lf

# Binary files: never normalised, never diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.mov  binary
*.webm binary
*.mkv  binary
*.wav  binary
*.mp3  binary
*.m4a  binary
*.zip  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

# Generated files: collapsed in review, never hand-edited.
.claude/skills/**   linguist-generated=true
.agents/skills/**   linguist-generated=true
SYSTEM.md           linguist-generated=true
docs/TOOLS.md       linguist-generated=true
docs/BOM.json       linguist-generated=true
docs/BOM.md         linguist-generated=true
uv.lock             linguist-generated=true
