root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# trailing double space is a hard line break in Markdown; Hebrew pages are RTL but the file stays plain UTF-8
trim_trailing_whitespace = false
indent_size = 2

[*.{json,jsonl,yml,yaml,toml,html,css,js}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
