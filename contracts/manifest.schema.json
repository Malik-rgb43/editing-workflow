{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editing-workflow.invalid/contracts/manifest.schema.json",
  "title": "Delivery manifest (projects/<name>/final/manifest.json)",
  "description": "Which source hash each delivered file was rendered from, and the gate states it was delivered under. No aggregate may be PASS while a required gate is not 'pass' (src: REPO_ARCHITECTURE section 8).",
  "type": "object",
  "required": [
    "schema",
    "project",
    "created_utc",
    "files",
    "gates",
    "aggregate"
  ],
  "properties": {
    "schema": {
      "const": "avc.delivery-manifest/1"
    },
    "project": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "description": "timezone-aware ISO-8601 (UTC preferred)"
    },
    "toolkit_version": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "platform"
        ],
        "properties": {
          "artifact": {
            "$ref": "artifact.schema.json"
          },
          "platform": {
            "type": "string"
          },
          "aspect": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "state",
          "required"
        ],
        "properties": {
          "state": {
            "enum": [
              "pass",
              "fail",
              "unsupported",
              "not_run",
              "insufficient_evidence",
              "error"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "aggregate": {
      "enum": [
        "PASS",
        "FAIL",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "human_review": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "approved_by": {
          "type": "string"
        },
        "approved_utc": {
          "type": "string",
          "format": "date-time",
          "description": "timezone-aware ISO-8601 (UTC preferred)"
        },
        "rubric_version": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "aggregate": {
            "const": "PASS"
          }
        },
        "required": [
          "aggregate"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "if": {
                "properties": {
                  "required": {
                    "const": true
                  }
                },
                "required": [
                  "required"
                ]
              },
              "then": {
                "properties": {
                  "state": {
                    "const": "pass"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
